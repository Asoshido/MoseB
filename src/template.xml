<?xml version='1.0' encoding='UTF-8' ?>
<!DOCTYPE html>
<html b:defaultwidgetversion='2' b:layoutsVersion='3' b:responsive='true'
      expr:dir='data:blog.languageDirection' lang='en'
      xmlns='http://www.w3.org/1999/xhtml'
      xmlns:b='http://www.google.com/2005/gml/b'
      xmlns:data='http://www.google.com/2005/gml/data'
      xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>
  <meta content='width=device-width, initial-scale=1' name='viewport'/>
  <meta content='text/html; charset=UTF-8' http-equiv='Content-Type'/>
  <title><data:blog.pageTitle/></title>
  <b:include data='blog' name='all-head-content'/>
  <b:skin><![CDATA[
{{STYLES}}
  ]]></b:skin>
</head>
<body>
  <div class='site-shell' id='top'>

    <!-- HEADER (HARDCODED IMAGE) -->
    <header class='site-header' role='banner'>
      <div class='header-section'>
        <div class='custom-logo-wrapper'>
          <!-- REPLACE THE URL BELOW WITH YOUR GITHUB IMAGE URL -->
          <a href='/'>
            <img src='https://raw.githubusercontent.com/Asoshido/MoseB/refs/heads/main/assets/Olabunmi_Mabel_Canva_Editable.pptx_20261115_144737_0000.png' alt='Top Love Hacks' class='custom-logo-image'/>
          </a>
        </div>
      </div>
    </header>

    <!-- PRIMARY NAVIGATION -->
    <nav aria-label='Primary navigation'
         class='primary-navigation' role='navigation'>
      <div class='navigation-inner'>

        <button aria-controls='primary-menu'
                aria-expanded='false'
                class='menu-toggle'
                id='menu-toggle'
                type='button'>
          <span class='menu-toggle-icon' aria-hidden='true'>&#10005;</span>
          <span class='menu-toggle-label'>Menu</span>
        </button>

        <b:section class='navigation-section'
                   id='primary-menu'
                   maxwidgets='1'
                   name='Navigation'
                   showaddelement='yes'>
          <b:widget id='PageList1' locked='false'
                    title='Pages' type='PageList' version='2'/>
        </b:section>

        <b:section class='navigation-search'
                   id='navigation-search'
                   maxwidgets='1'
                   name='Navigation Search'
                   showaddelement='yes'>
          <b:widget id='BlogSearch1' locked='false'
                    title='Search' type='BlogSearch' version='2'/>
        </b:section>

      </div>
    </nav>

    <!-- MAIN CONTENT -->
    <div class='content-layout'>

      <main class='main-content' id='main-content' role='main'>

        <b:section class='main-section' id='main'
                   name='Main Content' showaddelement='no'>

          <b:widget id='Blog1' locked='true'
                    title='Blog Posts' type='Blog' version='2'>

            <b:includable id='main' var='top'>

              <!-- ERROR PAGE -->
              <b:if cond='data:view.isError'>
                <section class='page-state page-error'>
                  <h1>Page not found</h1>
                  <p>The page you requested could not be found.</p>
                  <a expr:href='data:blog.homepageUrl'>Return to the homepage</a>
                </section>
              <b:else/>

                <!-- SEARCH, LABEL AND ARCHIVE HEADINGS -->
                <b:if cond='data:view.isSearch'>
                  <header class='archive-heading'><h1>Search results</h1></header>
                <b:elseif cond='data:view.isLabelSearch'/>
                  <header class='archive-heading'><h1>Label: <data:view.search.label/></h1></header>
                <b:elseif cond='data:view.isArchive'/>
                  <header class='archive-heading'><h1><data:blog.pageName/></h1></header>
                </b:if>

                <!-- INDIVIDUAL POST -->
                <b:if cond='data:view.isSingleItem'>
                  <b:loop values='data:posts' var='post'>
                    <article class='post-entry post-single' itemscope='itemscope' itemtype='https://schema.org/BlogPosting'>
                      
                      <header class='post-header'>
                        <h1 class='post-title' itemprop='headline'><data:post.title/></h1>
                        <div class='post-meta'>
                          <span class='post-date'><data:post.timestamp/></span>
                          <span class='post-comment-count'><data:post.numberOfComments/> comments</span>
                        </div>
                      </header>

                      <b:if cond='data:post.featuredImage'>
                        <div class='post-featured-image'>
                          <img expr:alt='data:post.title' expr:src='resizeImage(data:post.featuredImage, 1200, "16:9")' itemprop='image'/>
                        </div>
                      </b:if>

                      <div class='post-body' itemprop='articleBody'>
                        <data:post.body/>
                      </div>

                      <footer class='post-footer'>
                        <div class='post-labels'>
                          <b:loop values='data:post.labels' var='label'>
                            <a expr:href='data:label.url'><data:label.name/></a>
                          </b:loop>
                        </div>
                      </footer>
                      <b:include data='post' name='comments'/>
                    </article>
                  </b:loop>
                <b:else/>

                  <!-- HOMEPAGE AND ARCHIVE ARTICLE LIST -->
                  <div class='post-list'>
                    <b:loop values='data:posts' var='post'>
                      <article class='post-entry post-card'>

                        <!-- 1. TITLE FIRST -->
                        <b:if cond='data:post.title'>
                          <header class='post-header'>
                            <h2 class='post-title'>
                              <a expr:href='data:post.url'><data:post.title/></a>
                            </h2>
                          </header>
                        </b:if>

                        <!-- 2. IMAGE SECOND (EDGE TO EDGE) -->
                        <b:if cond='data:post.featuredImage'>
                          <a class='post-image-link' expr:href='data:post.url'>
                            <img class='post-thumbnail' expr:alt='data:post.title' expr:src='resizeImage(data:post.featuredImage, 800, "16:9")'/>
                          </a>
                        </b:if>

                        <!-- 3. EXCERPT -->
                        <div class='post-excerpt'>
                          <data:post.snippets.short/>
                        </div>

                        <!-- 4. READ MORE -->
                        <a class='read-more' expr:href='data:post.url'>Read more</a>

                        <!-- 5. METADATA -->
                        <footer class='post-meta'>
                          <span class='post-categories'>
                            <i class='meta-icon'>&#128193;</i>
                            <b:loop values='data:post.labels' var='label'>
                              <a expr:href='data:label.url'><data:label.name/></a>
                            </b:loop>
                          </span>
                          <a class='post-comment-count' expr:href='data:post.url + &quot;#comments&quot;'>
                            <i class='meta-icon'>&#128172;</i>
                            <data:post.numberOfComments/> comments
                          </a>
                        </footer>

                      </article>
                    </b:loop>
                  </div>

                  <!-- NATIVE BLOGGER PAGINATION -->
                  <nav aria-label='Post pagination' class='blog-pager'>
                    <b:if cond='data:newerPageUrl'>
                      <a class='newer-posts' expr:href='data:newerPageUrl'>&#8592; Previous</a>
                    </b:if>
                    <b:if cond='data:olderPageUrl'>
                      <a class='older-posts' expr:href='data:olderPageUrl'>Next &#8594;</a>
                    </b:if>
                  </nav>
                </b:if>
              </b:if>
            </b:includable>
          </b:widget>
        </b:section>
      </main>

      <!-- SIDEBAR (EMPTIED TO REMOVE BLOGGER DEFAULT WIDGETS) -->
      <aside aria-label='Sidebar' class='sidebar' role='complementary'>
        <b:section class='sidebar-section' id='sidebar' name='Sidebar' showaddelement='yes'>
           <!-- Widgets removed. You can add your own here later if needed. -->
        </b:section>
      </aside>
    </div>

    <!-- FOOTER -->
    <footer class='site-footer' role='contentinfo'>
      <div class='footer-search'>
        <h2 class='footer-search-title'>Looking for Something?</h2>
        <b:section class='footer-search-section' id='footer-search' maxwidgets='1' name='Footer Search' showaddelement='no'>
          <b:widget id='BlogSearch2' locked='false' title='Search' type='BlogSearch' version='2'/>
        </b:section>
      </div>
      <b:section class='footer-section' id='footer' name='Footer' showaddelement='yes'>
        <b:widget id='Attribution1' locked='true' title='' type='Attribution' version='2'/>
      </b:section>
      <div class='copyright'>
        <data:blog.title/> &#169; <data:blog.timestamp/>
      </div>
    </footer>
  </div>

  <button aria-label='Back to top' class='back-to-top' id='back-to-top' type='button' title='Back to top'>&#8593;</button>

  <script type='text/javascript'>//<![CDATA[
{{SCRIPTS}}
  //]]></script>
</body>
</html>
